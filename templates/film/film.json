{
  "version": 1,
  "kind": "film",
  "name": "my-film",
  "duration": 18,
  "fps": 60,
  "bpm": 100,
  "languages": [
    "zh",
    "en"
  ],
  "formats": [
    "landscape",
    "vertical"
  ],
  "composition": "composition/draw.js",
  "music": "builtin",
  "motionBlur": {
    "samples": 4,
    "shutter": 0.5
  },
  "copy": {
    "zh": {
      "problem": "从问题开始。",
      "problemNote": "用一个看得见的动作，讲清楚它。",
      "send": "行动发生。",
      "message": "一个信号",
      "result": "结果出现。",
      "network": "让变化继续。",
      "brand": "YOUR FILM",
      "promise": "为这个故事设计运动。",
      "cta": "替换这份示范，写你自己的镜头。",
      "a": "输入",
      "b": "结果",
      "c": "变化",
      "d": "下一步",
      "note": "自由创作起点 · 请改写镜头和文案"
    },
    "en": {
      "problem": "Start with a problem.",
      "problemNote": "Show it through an action.",
      "send": "Make it happen.",
      "message": "A signal",
      "result": "Show the result.",
      "network": "Keep it moving.",
      "brand": "YOUR FILM",
      "promise": "Motion made for this story.",
      "cta": "Replace this study with your own film.",
      "a": "INPUT",
      "b": "RESULT",
      "c": "CHANGE",
      "d": "NEXT",
      "note": "A drawing study, not a finished product ad"
    }
  },
  "shots": [
    {
      "id": "problem",
      "start": 0,
      "end": 3,
      "purpose": "Show the initial tension",
      "action": "Two separate objects drift toward each other but cannot connect",
      "narration": {
        "zh": "先看清问题。",
        "en": "Start with a problem."
      }
    },
    {
      "id": "signal",
      "start": 3,
      "end": 6,
      "purpose": "Introduce an action that changes the situation",
      "action": "The left object expands into a message and travels across the gap",
      "narration": {
        "zh": "一个动作，让变化发生。",
        "en": "Let an action change it."
      }
    },
    {
      "id": "response",
      "start": 6,
      "end": 10,
      "purpose": "Show the visible consequence",
      "action": "The message lands; a response radiates from the receiving object",
      "narration": {
        "zh": "结果，比解释更直观。",
        "en": "Show the result."
      }
    },
    {
      "id": "expand",
      "start": 10,
      "end": 14,
      "purpose": "Reveal the wider system",
      "action": "The camera pulls back while the same objects form a working network",
      "narration": {
        "zh": "让画面跟着故事走。",
        "en": "Follow the story with motion."
      }
    },
    {
      "id": "brand",
      "start": 14,
      "end": 18,
      "purpose": "Resolve the motif into the identity",
      "action": "The network contracts into a mark; the wordmark takes over the frame",
      "narration": {
        "zh": "这是你自己的影片。",
        "en": "Make the film your own."
      }
    }
  ],
  "voiceover": {
    "dir": "voiceover",
    "rate": {
      "zh": "+8%",
      "en": "+5%"
    }
  }
