      "hold": 0.9,
      "holdReason": "Read the message and the direct-message command before the packet leaves."
    },
    {
      "id": "deliver",
      "start": 3.6,
      "end": 5.4,
      "purpose": "Make delivery visible",
      "action": "The same capsule accelerates along the connector and contracts into the receiving agent"
    },
    {
      "id": "wake",
      "start": 5.4,
      "end": 7.2,
      "purpose": "Show what makes OCS useful",
      "action": "A wake pulse expands to fill the frame; the recipient responds along the return path",
      "hold": 1.1,
      "holdReason": "Let the wake result register after the frame-filling arrival."
    },
    {
      "id": "connect",
      "start": 7.2,
      "end": 9.6,
      "purpose": "Show the supported agent ecosystem",
      "action": "The camera pulls out of the recipient into a four-agent routing system; packets follow its paths"
    },
